# Environment Variables Template
# Copy this to .env and fill in your values

# Bot Token from @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Admin Telegram IDs (comma-separated)
ADMIN_IDS=YOUR_ADMIN_ID_HERE

# Required Channel (without @)
REQUIRED_CHANNEL_USERNAME=YourChannelName

# Channel Numeric ID (get from @userinfobot)
CHANNEL_ID=YOUR_CHANNEL_NUMERIC_ID

# Database Path (default: netflix_cookies.db)
DB_PATH=netflix_cookies.db
